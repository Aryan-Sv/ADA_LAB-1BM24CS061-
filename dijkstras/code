#include <stdio.h>
#include <limits.h>

#define MAX 10
#define INF 9999

void dijkstra(const int graph[MAX][MAX], int n, int start) {
    int distance[MAX], visited[MAX];
    int count, nextnode, minDistance;

    for (int i = 0; i < n; i++) {
        distance[i] = INF;
        visited[i] = 0;
    }

    distance[start] = 0;

    for (count = 0; count < n - 1; count++) {
        minDistance = INF;

        for (int i = 0; i < n; i++) {
            if (!visited[i] && distance[i] < minDistance) {
                minDistance = distance[i];
                nextnode = i;
            }
        }

        visited[nextnode] = 1;

        for (int i = 0; i < n; i++) {
            if (!visited[i] && graph[nextnode][i] &&
                (distance[nextnode] + graph[nextnode][i] < distance[i])) {
                distance[i] = distance[nextnode] + graph[nextnode][i];
            }
        }
    }

    printf("Vertex\tDistance from Source\n");
    for (int i = 0; i < n; i++) {
        printf("%d\t%d\n", i, distance[i]);
    }
}

int main() {
    const int graph[MAX][MAX] = {
        {0, 4, 0, 0, 0, 0, 0, 8, 0},
        {4, 0, 8, 0, 0, 0, 0, 11, 0},
        {0, 8, 0, 7, 0, 4, 0, 0, 2},
        {0, 0, 7, 0, 9, 14, 0, 0, 0},
        {0, 0, 0, 9, 0, 10, 0, 0, 0},
        {0, 0, 4, 14, 10, 0, 2, 0, 0},
        {0, 0, 0, 0, 0, 2, 0, 1, 6},
        {8, 11, 0, 0, 0, 0, 1, 0, 7},
        {0, 0, 2, 0, 0, 0, 6, 7, 0}
    };
    int nodes = 9;
    dijkstra(graph, nodes, 0);
    return 0;
}
