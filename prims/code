#include <stdio.h>
#include <limits.h>

#define MAX 100

int main() {
    int n, cost[MAX][MAX], visited[MAX] = {0};
    int i, j, min, x = 0, y = 0, total = 0, edges = 0;

    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
            if(cost[i][j] == 0)
                cost[i][j] = INT_MAX;
        }
    }

    visited[0] = 1;

    while(edges < n - 1) {
        min = INT_MAX;

        for(i = 0; i < n; i++) {
            if(visited[i]) {
                for(j = 0; j < n; j++) {
                    if(!visited[j] && cost[i][j] < min) {
                        min = cost[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        printf("%d - %d\n", x, y);
        total += min;
        visited[y] = 1;
        edges++;
    }

    printf("%d\n", total);

    return 0;
}
