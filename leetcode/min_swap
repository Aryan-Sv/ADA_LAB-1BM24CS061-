#include <stdio.h>
int MIN(a, b) ((a) < (b) ? (a) : (b))

int minSwap(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    int keep = 0;
    int swap = 1;
    int INF = nums1Size + 1; 
    for (int i = 1; i < nums1Size; i++) {
        int next_keep = INF;
        int next_swap = INF; 
        if (nums1[i] > nums1[i - 1] && nums2[i] > nums2[i - 1]) {
            next_keep = MIN(next_keep, keep);
            next_swap = MIN(next_swap, swap + 1);
        }
        if (nums1[i] > nums2[i - 1] && nums2[i] > nums1[i - 1]) {
            next_keep = MIN(next_keep, swap);
            next_swap = MIN(next_swap, keep + 1);
        }
        keep = next_keep;
        swap = next_swap;
    }
    return MIN(keep, swap);
}

void main() {
    int nums1[] = {1, 3, 5, 4};
    int nums2[] = {1, 2, 3, 7};
    int size = sizeof(nums1) / sizeof(nums1[0]);   
    int result = minSwap(nums1, size, nums2, size);
    printf("%d\n", result);
    
}
