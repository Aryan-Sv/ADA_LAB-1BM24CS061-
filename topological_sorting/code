#include <stdio.h>
#define MAX 100

int n;                 
int adj[MAX][MAX];          
int indegree[MAX];        

void topologicalSort(){
    int i, j, count = 0;
    int visited[MAX] = {0};
    printf("Topological Ordering:\n");
    while (count < n){
        int found = 0;
        for (i = 0; i < n; i++){
            if (indegree[i] == 0 && visited[i] == 0){
                printf("%d ", i);
                visited[i] = 1;
                found = 1;
                count++;
                for (j = 0; j < n; j++){
                    if (adj[i][j] == 1){
                        indegree[j]--;
                    }
                }
            }
        }

        if (!found){
            printf("\nGraph contains a cycle. Topological ordering not possible.\n");
            return;
        }
    }
    printf("\n");
}

void main()
{
    int i, j;
    printf("Enter number of vertices: ");
    scanf("%d", &n);
    printf("Enter adjacency matrix:\n");
    for (i = 0; i < n; i++){
        for (j = 0; j < n; j++){
            scanf("%d", &adj[i][j]);
        }
    }
    for (j = 0; j < n; j++){
        indegree[j] = 0;
        for (i = 0; i < n; i++){
            indegree[j] += adj[i][j];
        }
    }
    topologicalSort();
}
